# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
build/
.next/
.turbo/
.cache/
.parcel-cache/
backend/dist/
.vercel/

# Environment files — never commit real values
.env
.env.local
.env.production
.env*.local
backend/.env
backend/.env.production
backend/.env*
# Keep example files tracked
!.env.example
!backend/.env.example

# Keys folder — local reference only
/keys/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
.venv/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
htmlcov/
.coverage
.coverage.*
.tox/
.nox/
pip-wheel-metadata/

# Logs and temp files
*.log
*.tsbuildinfo
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*~

# IDE
.idea/
*.swp
*.swo
# VS Code — track settings.json and extensions.json (project-level),
# ignore personal workspace files
.vscode/*.code-workspace

# Credentials — never commit
*.pem
*.key
*.p8
*.p12
*.jks
*.mobileprovision

# TypeScript build info
*.tsbuildinfo

# Misc
.ipynb_checkpoints/
coverage/
.nyc_output/
